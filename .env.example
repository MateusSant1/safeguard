# Copie este arquivo para ".env" e preencha com os valores reais.
# NUNCA commite o arquivo ".env" (ele já está no .gitignore).

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Índice da webcam (0 = primeira câmera do sistema)
CAMERA_INDEX=0

# --- Opcionais (valores padrão entre parênteses) ---
# MOTION_THRESHOLD_AREA=500      # área mínima de movimento (px)
# CONFIDENCE_THRESHOLD=0.26      # confiança mínima da detecção de pessoa
# WARM_UP_FRAMES=30              # frames para o fundo "assentar" ao iniciar
# DECISION_MODE=overlap          # foot | center | overlap
# MIN_OVERLAP_RATIO=0.15         # usado no modo overlap
# SERVER_HOST=0.0.0.0
# SERVER_PORT=5000
# JPEG_QUALITY=80
